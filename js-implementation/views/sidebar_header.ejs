<aside>
    <div class="header_div">
        <div class="logo1">
            <img src="/assets/logo.png" class="logo_image" alt="PRISM Logo">
            <h1>PRISM</h1>
        </div>
        <div class="logo_user">
            <p><%= user && user.role === 'admin' ? 'Admin Portal' : 'Staff Portal' %></p>
        </div>
    </div>
    
    <nav>
        <a href="/dashboard" class="<%= current === 'dashboard' ? 'active' : '' %>">
            <img src="/assets/dash_icon.png" alt="Dashboard">
            <p>Dashboard</p>
        </a>
        
        <a href="/products" class="<%= current === 'products' ? 'active' : '' %>">
            <img src="/assets/products_icon.png" alt="Products">
            <p>Products</p>
        </a>
        
        <a href="/stock-movement" class="<%= current === 'stock-movement' ? 'active' : '' %>">
            <img src="/assets/move_icon.png" alt="Stock Movements">
            <p>Stock Movements</p>
        </a>
        
        <a href="/reports/low_stock" class="<%= (current === 'low_stock' || current === 'reports' || current === 'valuation' || current === 'movement_ledger' || current === 'top_movers') ? 'active' : '' %>">
            <img src="/assets/report_icon.png" alt="Reports">
            <p>Reports</p>
        </a>
        
        <% if (user && user.role === 'admin') { %>
        <a href="/profile" class="<%= current === 'profile' ? 'active' : '' %>">
            <img src="/assets/profile_icon.png" alt="Profile">
            <p>Profile</p>
        </a>
        <% } %>
    </nav>

    <div class="user-panel">
        <div class="user">
            <div class="profile">
                <img src="/assets/user_icon.png" class="logo_image" alt="User">
            </div>
            <div class="status">
                <p><%= user ? user.username : 'User' %></p>
                <p id="role"><%= user ? user.role.toUpperCase() : 'STAFF' %></p>
            </div>
        </div>
        <a href="#" onclick="document.getElementById('logoutOverlay').classList.add('show')" class="logout-link" style="display:flex; align-items:center; justify-content:center; gap:6px; width:100%; height:48px; margin-top:12px; border-radius:16px; background:rgba(255,255,255,0.1); text-decoration:none;">
            <img src="/assets/logout_icon.png" class="logout_image" alt="Logout">
            <p id="logout">Logout</p>
        </a>
    </div>
</aside>

<div class="prism-overlay" id="logoutOverlay">
    <div class="prism-modal small">
        <h3 class="confirm-title">Confirmation of <span class="text-maroon">Log Out</span></h3>
        <p class="confirm-text">Are you sure you want to log out?</p>
        <div class="modal-footer center">
            <form action="/logout" method="POST" style="display:inline;">
                <button type="submit" class="btn-action-solid">Log out</button>
            </form>
            <button type="button" class="btn-cancel-solid" onclick="document.getElementById('logoutOverlay').classList.remove('show')">Cancel</button>
        </div>
    </div>
</div>

<div class="main">
    <div class="header">
        <div class="left">
            <div><img src="/assets/sidebar_icon.png" alt="Menu"></div>
            <p>PRISM | Inventory Management</p>
        </div>
        <div class="right">
            <div class="role">
                <p><%= user ? user.role.toUpperCase() : 'STAFF' %></p>
            </div>
            <div class="user">
                <p><%= user ? user.username : 'User' %></p>
            </div>
        </div>
    </div>
