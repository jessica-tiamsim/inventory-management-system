<aside>
    <div class="header_div">
        <div class="logo1">
            <img src="/assets/logo.png" class="logo_image">
            <h1>PRISM</h1>
        </div>
        <div class="logo_user">
            <p>Admin Portal</p>
        </div>
    </div>
    
    <nav>
        <a href="/dashboard" class="<%= current === 'dashboard' ? 'active' :  '' %>">
            <img src="/assets/dash_icon.png" alt="Dashboard">
            <p>Dashboard</p>
        </a>
        
        <a href="/products" class="<%= current === 'products' ? 'active' :  '' %>">
            <img src="/assets/products_icon.png" alt="Products">
            <p>Products</p>
        </a>
        
        <a href="/stock_movement" class="<%= current === 'stock_movement' ? 'active' :  '' %>">
            <img src="/assets/move_icon.png" alt="Stock Movements">
            <p>Stock Movements</p>
        </a>
        
        <a href="/reports/low_stock" class="<%= current === 'low_stock' ? 'active' :  '' %>">
            <img src="/assets/report_icon.png" alt="Reports">
            <p>Reports</p>
        </a>
        
        <a href="/profile" class="<%= current === 'profile' ? 'active' :  '' %>">
            <img src="/assets/profile_icon.png" alt="Profile">
            <p>Profile</p>
        </a>
    </nav>

    <div class="user-panel">
        <div class="user">
            <div class="profile">
                <img src="/assets/user_icon.png" class="logo_image" alt="User">
            </div>
            <div class="status">
                <p><%= user.username %></p> 
                <p id="role"><%= user.role.toUpperCase() %></p>
            </div>
        </div>
        <button type="button" onclick="openLogoutModal(event)">
            <img src="/assets/logout_icon.png" class="logout_image" alt="Logout">
            <p id="logout">Logout</p>
        </button>
    </div>
</aside>

<div class="main">
    <header>
        <div class="header">
            <div class="left">
                <div><img src="/assets/sidebar_icon.png"></div>
                <p>PRISM | Inventory Management</p>
            </div>
            <div class="right">
                <div class="role">
                    <p><%= user.role.toUpperCase() %></p>
                </div>
                <div class="user">
                    <p><%= user.username %></p>
                </div> 
            </div>
        </div>
    </header>

<div class="logout_overlay" id="logoutOverlay">
    <div class="logout_modal_card">
        <h2 class="logout_title">Confirmation of <span class="highlight_red">Log Out</span></h2>
        <p class="logout_message">Are you sure you want to log out?</p>
        <div class="modal_actions">
            <form action="/logout" method="POST" style="display: inline;">
                <button type="submit" class="btn_logout">Log out</button>
            </form>
            <button type="button" class="btn_cancel" onclick="closeLogoutModal()">Cancel</button>
        </div>
    </div>
</div>

<script>
    function openLogoutModal(event) {
        event.preventDefault(); 
        document.getElementById('logoutOverlay').style.setProperty('display', 'flex', 'important');
    }

    function closeLogoutModal() {
        document.getElementById('logoutOverlay').style.setProperty('display', 'none', 'important');
    }

    // Dynamic background click dismiss hook
    window.onclick = function(event) {
        const overlay = document.getElementById('logoutOverlay');
        if (event.target === overlay) {
            closeLogoutModal();
        }
    }
</script>