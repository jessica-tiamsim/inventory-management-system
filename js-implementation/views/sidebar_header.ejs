<aside>
    <div class="header_div">
        <div class="logo1">
            <img src="assets/logo.png" class="logo_image" alt="PRISM Logo">
            <h1>PRISM</h1>
        </div>
        <div class="logo_user">
            <p>Admin Portal</p>
        </div>
    </div>
    
    <nav>
        <a href="/dashboard" class="active">
            <img src="assets/dash_icon.png" alt="Dashboard">
            <p>Dashboard</p>
        </a>
        
        <a href="/products">
            <img src="assets/products_icon.png" alt="Products">
            <p>Products</p>
        </a>
        
        <a href="#">
            <img src="assets/move_icon.png" alt="Stock Movements">
            <p>Stock Movements</p>
        </a>
        
        <a href="#">
            <img src="assets/report_icon.png" alt="Reports">
            <p>Reports</p>
        </a>
        
        <a href="#">
            <img src="assets/profile_icon.png" alt="Profile">
            <p>Profile</p>
        </a>
    </nav>

    <div class="user-panel">
        <div class="user">
            <div class="profile">
                <img src="assets/user_icon.png" class="logo_image" alt="User">
            </div>
            <div class="status">
                <p><%= user.username %></p> 
                <p id="role"><%= user.role.toUpperCase() %></p>
            </div>
        </div>
        <a href="/logout">
            <img src="assets/logout_icon.png" class="logout_image" alt="Logout">
            <p id="logout">Logout</p>
        </a>
    </div>
</aside>

<div class="main">
    <header>
        <div class="header">
            <div class="left">
                <div><img src="assets/menu-icon.png" alt="Menu"></div>
                <p>PRISM | Inventory Management</p>
            </div>
            <div class="right">
                <div class="role">
                    <p><%= user.role.toUpperCase() %></p>
                </div>
                <div class="user">
                    <p><%= user.username %></p>
                </div> 
            </div>
        </div>
    </header>