<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PRISM | Reports</title>
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/low_stock.css">
    <link rel="stylesheet" href="/css/sidebar_header.css">
    <link href='https://fonts.googleapis.com/css?family=Inter:wght@400;500;600;700&display=swap' rel='stylesheet'>
</head>
<body>

    <%- include('../sidebar_header', { current: 'low_stock' }) %>

    <div class="content">
        <div class="box1">
            <h1 class="page-title">Reports</h1>
            <p class="box1_sub">Insights across your inventory operations.</p>
            
            <div class="choices">
                <a href="/reports/low_stock" class="tab-link"><span class="active">Low Stock</span></a>
                <a href="/reports/valuation" class="tab-link"><span class="inactive-tab">Valuation</span></a>
                <a href="/reports/movement_ledger" class="tab-link"><span class="inactive-tab">Movement Ledgers</span></a>
                <a href="/reports/top_movers" class="tab-link"><span class="inactive-tab">Tops Movers</span></a>
            </div>
        </div>

        <div class="box2">
            <div class="box2_left">
                <h4 class="section-title">Low Stock Report</h4>
                <p class="box2_sub">Active products at or below their reorder threshold</p>
            </div>
            <div class="box2_right">
                <form method="GET" action="/reports/low_stock" class="filter-form">
                    <select name="product" id="product" onchange="this.form.submit()">
                        <option value="all" <%= selectedProduct !== 'undefined' && selectedProduct === 'all' ? 'selected' : '' %>>All Products</option>
                        <% if (typeof products !== 'undefined' && products.length > 0) { %>
                        <% products.forEach(function(p) { %>
                            <option value="<%= p.id %>" <%= typeof selectedProduct !== 'undefined' && Number(selectedProduct) === p.id ? 'selected' : '' %>>
                                <%= p.name %>
                            </option>
                        <% }); %>
                    <% } %>
                    </select>
                    
                    <a href="/reports/low_stock?export=csv&product=<%= selectedProduct %>" class="excel btn-export">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                        CSV
                    </a>
                </form>
            </div>
        </div>

        <div class="box3">
            <div class="table-scroll-wrapper">
            <table>
                <thead>
                    <tr>
                        <th class="text-left">SKU</th>
                        <th class="text-left">Product Name</th>
                        <th class="text-left">Category</th>
                        <th class="text-center">Quantity</th>
                        <th class="text-center">Reorder Threshold</th>
                        <th class="text-center">Supplier Name</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (lowStockData && lowStockData.length > 0) { %>
                        <% lowStockData.forEach(item => { %>
                    <tr>
                        <td class="text-left"><strong><%= item.sku %></strong></td>
                        <td class="text-left"><%= item.name %></td>
                        <td class="text-left"><%= item.category_name || 'N/A' %></td>
                        <td class="text-center" style="color: #801B32; font-weight: 600;">
                            <%= item.current_quantity %>
                        </td>
                        <td class="text-center">
                            <%= item.reorder_threshold %>
                        </td>
                        <td class="text-center"><%= item.supplier_name || 'N/A' %></td>
                    </tr>
                    <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="6" class="empty-state">
                            No low stock items found for this filter.
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>

        <div class="pagination-container" style="margin-top: 20px; display: flex; gap: 6px; justify-content: flex-end;">
            <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
                <% 
                   let currentProduct = typeof selectedProduct !== 'undefined' ? selectedProduct : 'all'; 
                   let pageSafe = typeof currentPage !== 'undefined' ? currentPage : 1;
                %>

                <% if (pageSafe > 1) { %>
                    <a href="?page=<%= pageSafe - 1 %>&product=<%= currentProduct %>" class="page-step">&laquo; Prev</a>
                <% } %>
        
                <% for(let i = 1; i <= totalPages; i++) { %>
                    <a href="?page=<%= i %>&product=<%= currentProduct %>" 
                       class="page-step <%= pageSafe === i ? 'active-page' : '' %>">
                        <%= i %>
                    </a>
                <% } %>
        
                <% if (pageSafe < totalPages) { %>
                    <a href="?page=<%= pageSafe + 1 %>&product=<%= currentProduct %>" class="page-step">Next &raquo;</a>
                <% } %>
            <% } %>
        </div>

    </div>
</body>
</html>