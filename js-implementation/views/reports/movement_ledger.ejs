<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PRISM | Movement Ledger</title>
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/sidebar_header.css">
    <link rel="stylesheet" href="/css/movement_ledger.css">
    <style>
        .badge-pill { display:inline-block; padding:6px 16px; border-radius:20px; font-size:12px; font-weight:600; text-align:center; border:1px solid transparent; }
        .badge-in { background-color:#DBFCE7; color:#15A85A; border-color:#BFF3D4; }
        .badge-out { background-color:#FEE2E2; color:#EF4444; border-color:#FCA5A5; }
        .badge-adjustment { background-color:#FEF3C7; color:#D97706; border-color:#FCD34D; }
        .qty-positive { color:#15A85A; font-weight:600; }
        .qty-negative { color:#EF4444; font-weight:600; }
    </style>
</head>
<body>
    <%- include('../sidebar_header', { current: 'low_stock' }) %>

    <div class="content">
        <div class="box1">
            <h1 class="page-title">Reports</h1>
            <p class="box1_sub">Insights across your inventory operations.</p>

            <div class="choices">
                <a href="/reports/low_stock" class="tab-link"><span class="inactive-tab">Low Stock</span></a>
                <a href="/reports/valuation" class="tab-link"><span class="inactive-tab">Valuation</span></a>
                <a href="/reports/movement_ledger" class="tab-link"><span class="active">Movement Ledgers</span></a>
                <a href="/reports/top_movers" class="tab-link"><span class="inactive-tab">Top Movers</span></a>
            </div>

            <form method="GET" action="/reports/movement_ledger" style="margin-top:25px;">
                <div class="date" style="display:flex; align-items:center;">
                    <label for="date1" style="margin-right:5px;">From:</label>
                    <input type="date" name="start_date" id="date1"
                        value="<%= typeof startDate !== 'undefined' ? startDate : '' %>"
                        style="padding:6px; border:1px solid var(--border-light); border-radius:4px;">

                    <label for="date2" style="margin-left:15px; margin-right:5px;">To:</label>
                    <input type="date" name="end_date" id="date2"
                        value="<%= typeof endDate !== 'undefined' ? endDate : '' %>"
                        style="padding:6px; border:1px solid var(--border-light); border-radius:4px;">

                    <button type="submit" style="margin-left:15px; padding:8px 16px; background:var(--maroon); color:white; border:none; border-radius:6px; cursor:pointer; font-weight:600;">Apply Filter</button>
                </div>
            </form>
        </div>

        <div class="box2">
            <div class="box2_left">
                <h4 class="section-title">Movement Ledger Audit</h4>
                <p class="box2_sub">Comprehensive history of all inventory adjustments and transactions.</p>
            </div>
            <div class="box2_right">
                <form method="GET" action="/reports/movement_ledger" class="filter-form">
                    <select name="product" onchange="this.form.submit()">
                        <option value="all" <%= (typeof selectedProduct === 'undefined' || selectedProduct === 'all') ? 'selected' : '' %>>All Products</option>
                        <% if (typeof products !== 'undefined') { products.forEach(function(p) { %>
                            <option value="<%= p.id %>" <%= (typeof selectedProduct !== 'undefined' && String(selectedProduct) === String(p.id)) ? 'selected' : '' %>><%= p.name %></option>
                        <% }); } %>
                    </select>

                    <select name="movement_type" onchange="this.form.submit()">
                        <option value="all" <%= (!selectedType || selectedType === 'all') ? 'selected' : '' %>>All Types</option>
                        <option value="in" <%= (selectedType === 'in') ? 'selected' : '' %>>Stock-In</option>
                        <option value="out" <%= (selectedType === 'out') ? 'selected' : '' %>>Stock-Out</option>
                        <option value="adjustment" <%= (selectedType === 'adjustment') ? 'selected' : '' %>>Adjustments</option>
                    </select>

                    <a href="/reports/movement_ledger?export=csv" class="excel btn-export">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                        CSV
                    </a>
                </form>
            </div>
        </div>

        <div class="box3">
            <table>
                <thead>
                    <tr class="header-box">
                        <th class="text-left">Date & Time</th>
                        <th class="text-left">SKU</th>
                        <th class="text-left">Product Name</th>
                        <th class="text-center">Type</th>
                        <th class="text-center">Quantity</th>
                        <th class="text-left">Recorded By</th>
                        <th class="text-left">Notes</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (typeof movements !== 'undefined' && movements.length > 0) { %>
                        <% movements.forEach(function(row) { %>
                            <%
                                var typeLower = (row.movement_type || '').toLowerCase();
                                var isPositive = (typeLower === 'in' || (typeLower === 'adjustment' && row.quantity > 0));
                                var qtyClass = isPositive ? 'qty-positive' : 'qty-negative';
                                var qtyPrefix = isPositive ? '+' : '-';
                            %>
                            <tr>
                                <td class="text-left" style="white-space:nowrap;">
                                    <%= new Date(row.date_time).toLocaleString('en-US', { month:'short', day:'2-digit', year:'numeric', hour:'2-digit', minute:'2-digit', hour12:true }) %>
                                </td>
                                <td class="text-left"><strong><%= row.sku %></strong></td>
                                <td class="text-left"><%= row.product_name %></td>
                                <td class="text-center">
                                    <span class="badge-pill badge-<%= typeLower %>">
                                        <%= typeLower === 'in' ? 'Stock-In' : (typeLower === 'out' ? 'Stock-Out' : 'Adjustment') %>
                                    </span>
                                </td>
                                <td class="text-center <%= qtyClass %>">
                                    <%= qtyPrefix %><%= Math.abs(row.quantity) %>
                                </td>
                                <td class="text-left"><%= row.recorded_by || 'System' %></td>
                                <td class="text-left" style="color:#666; font-size:13px; max-width:250px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
                                    <%= row.notes || '—' %>
                                </td>
                            </tr>
                        <% }); %>
                    <% } else { %>
                        <tr>
                            <td colspan="7" class="empty-state">No movement transaction records found inside selected range.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>
