<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PRISM | Stock Movements</title>
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/sidebar_header.css">
    <link rel="stylesheet" href="/css/stock_movement.css">
</head>
<body>
    <%- include('sidebar_header', { current: 'stock_movement' }) %>

    <div class="content">
        <% if (typeof successMessage !== 'undefined' && successMessage) { %>
            <div style="background:#DBFCE7; border:1px solid #BFF3D4; color:#15A85A; padding:16px; border-radius:8px; margin-bottom:20px; font-weight:600;">
                ✅ <%= successMessage %>
            </div>
        <% } %>
        <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
            <div style="background:#FEE2E2; border:1px solid #FCA5A5; color:#EF4444; padding:16px; border-radius:8px; margin-bottom:20px; font-weight:600;">
                ⚠️ <%= errorMessage %>
            </div>
        <% } %>

        <div class="page-top-header">
            <div class="header-left">
                <h1>Stock Movements</h1>
                <p class="subtitle">Immutable ledger of every stock change.</p>

                <form method="GET" action="/stock_movement" class="filters-row" style="margin-top: 15px;">
                    <select name="sku" onchange="this.form.submit()">
                        <option value="all" <%= (typeof skuFilter !== 'undefined' && skuFilter === 'all') ? 'selected' : '' %>>All Products</option>
                        <% if (typeof products !== 'undefined' && products.length > 0) { %>
                            <% products.forEach(function(p) { %>
                                <option value="<%= p.sku %>" <%= (typeof skuFilter !== 'undefined' && skuFilter === p.sku) ? 'selected' : '' %>>
                                    <%= p.name %>
                                </option>
                            <% }); %>
                        <% } %>
                    </select>

                    <select name="type" onchange="this.form.submit()">
                        <option value="all" <%= (typeof typeFilter !== 'undefined' && typeFilter.toLowerCase() === 'all') ? 'selected' : '' %>>All Types</option>
                        <option value="in" <%= (typeof typeFilter !== 'undefined' && typeFilter.toLowerCase() === 'in') ? 'selected' : '' %>>Stock In</option>
                        <option value="out" <%= (typeof typeFilter !== 'undefined' && typeFilter.toLowerCase() === 'out') ? 'selected' : '' %>>Stock Out</option>
                        <option value="adjustment" <%= (typeof typeFilter !== 'undefined' && typeFilter.toLowerCase() === 'adjustment') ? 'selected' : '' %>>Adjustment</option>
                    </select>
                </form>
            </div>

            <div class="header-right">
                <button class="btn-record-movement" onclick="openModal('movementModal')">
                    <img src="/assets/add_red.png" class="add_image" alt="Add" style="width:20px;"> Record Movement
                </button>
            </div>
        </div>

        <div class="data-card-surface">
            <div class="table-scroll-wrapper">
                <table>
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Product</th>
                            <th>Type</th>
                            <th>Quantity</th>
                            <th>Note</th>
                            <th>Recorded By</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (typeof movements !== 'undefined' && movements.length > 0) { %>
                            <% movements.forEach(function(m) { %>
                                <%
                                    var typeLower = (m.type || '').toLowerCase();
                                    var qtyPrefix = (typeLower === 'in' || (typeLower === 'adjustment' && m.quantity > 0)) ? '+' : '-';
                                    var qtyColor = (qtyPrefix === '+') ? '#15A85A' : '#EF4444';
                                %>
                                <tr>
                                    <td style="white-space:nowrap;"><%= m.date %></td>
                                    <td><strong><%= m.product_name %></strong></td>
                                    <td>
                                        <span class="badge-pill badge-<%= typeLower %>">
                                            <%= typeLower === 'in' ? 'Stock-In' : (typeLower === 'out' ? 'Stock-Out' : 'Adjustment') %>
                                        </span>
                                    </td>
                                    <td class="qty-weight" style="color:<%= qtyColor %>; font-size:15px;">
                                        <%= qtyPrefix %><%= Math.abs(m.quantity) %>
                                    </td>
                                    <td class="note-text-dim" style="max-width:250px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                                        <%= m.note || '—' %>
                                    </td>
                                    <td><%= m.recorded_by || 'System' %></td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="6" class="empty-fallback-row">
                                    📦 No stock transaction logs recorded matching criteria selection.
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>

            <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
                <div class="pagination-container" style="padding-bottom:20px;">
                    <%
                        var currentSku = typeof skuFilter !== 'undefined' ? skuFilter : 'all';
                        var currentType = typeof typeFilter !== 'undefined' ? typeFilter : 'all';
                        var pageSafe = typeof currentPage !== 'undefined' ? currentPage : 1;
                    %>
                    <% if (pageSafe > 1) { %>
                        <a href="?page=<%= pageSafe - 1 %>&sku=<%= currentSku %>&type=<%= currentType %>" class="page-step">&laquo; Prev</a>
                    <% } %>
                    <% for (var i = 1; i <= totalPages; i++) { %>
                        <a href="?page=<%= i %>&sku=<%= currentSku %>&type=<%= currentType %>"
                            class="page-step <%= pageSafe === i ? 'active-page' : '' %>"><%= i %></a>
                    <% } %>
                    <% if (pageSafe < totalPages) { %>
                        <a href="?page=<%= pageSafe + 1 %>&sku=<%= currentSku %>&type=<%= currentType %>" class="page-step">Next &raquo;</a>
                    <% } %>
                </div>
            <% } %>
        </div>
    </div>

    <!-- Record Movement Modal -->
    <div class="prism-overlay" id="movementModal">
        <div class="prism-modal large">
            <div class="modal-header"><h2>Record Stock Movement</h2></div>
            <form action="/stock_movement/add" method="POST" id="movementForm">
                <div class="form-grid">
                    <div class="form-group full"><label>Select Product *</label>
                        <select name="product_id" required>
                            <option value="" disabled selected>-- Choose a Product --</option>
                            <% if (typeof products !== 'undefined' && products.length > 0) { %>
                                <% products.forEach(function(p) { %>
                                    <option value="<%= p.id %>"><%= p.name %> (<%= p.sku %>)</option>
                                <% }); %>
                            <% } %>
                        </select>
                    </div>
                    <div class="form-group"><label>Movement Type *</label>
                        <select name="type" required>
                            <option value="" disabled selected>-- Select Type --</option>
                            <option value="in">Stock In (+)</option>
                            <option value="out">Stock Out (-)</option>
                            <option value="adjustment">Adjustment (Correction)</option>
                        </select>
                    </div>
                    <div class="form-group"><label>Quantity *</label>
                        <input type="number" name="quantity" min="1" placeholder="e.g. 50" required>
                    </div>
                    <div class="form-group full"><label>Reason / Notes</label>
                        <textarea name="notes" placeholder="Provide context metadata..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-cancel-outline" onclick="closeModal('movementModal')">Cancel</button>
                    <button type="submit" class="btn-save-maroon">Save Transaction</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        function openModal(id) { document.getElementById(id).classList.add('show'); }
        function closeModal(id) {
            document.getElementById(id).classList.remove('show');
            if (id === 'movementModal') document.getElementById('movementForm').reset();
        }
        document.querySelectorAll('.prism-overlay').forEach(function(overlay) {
            overlay.addEventListener('click', function(e) {
                if (e.target === overlay) closeModal(overlay.id);
            });
        });
    </script>
</body>
</html>
