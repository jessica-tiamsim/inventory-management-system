<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>PRISM Web App</title>
        <link rel="stylesheet" href="/login.css">
    </head>
    <body>
        <div class="login_screen">
            <div class = "logo_div">
                <img src="logo.png" class ="prism_img">
                    <h1 class = "logo_text">PRISM</h1>

            </div>
            <div class="login_card">
                <h2>Log in</h2>
                <form id="loginForm" method="POST" action="/login">
                    <label for="username_email">Username or Email</label>
                    <input id="username" type="text" name="username" placeholder="Username or Email" required>

                    <label for="password">Password</label>
                    <input id="password" type="password" name="password" placeholder="Password" required>
                    <button type="submit" class="btn-gold">Log in</button>
                </form>
                <div id="message">
                    <% if (error) { %>
                        <div class="error"> <%= error %></div>
                    <% } %>
                </div>
            </div>
        </div>
    </body>
</html>